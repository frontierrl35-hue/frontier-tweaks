# Copy this to .env (locally) or paste these into your host's environment
# variable settings (Render/Railway/Fly/etc all have a place for this).
# NEVER commit a real .env file or paste these values into the Electron app.

# Discord Developer Portal -> your app -> OAuth2 -> Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Developer Portal -> your app -> Bot -> Token (create a bot if you
# haven't; it just needs to sit in your server, no gateway/online presence
# required for this to work).
DISCORD_BOT_TOKEN=

# Your server's ID. In Discord: enable Settings -> Advanced -> Developer Mode,
# then right-click your server icon -> Copy Server ID.
DISCORD_GUILD_ID=

# The role ID for "Premium Tweaker". Right-click the role in
# Server Settings -> Roles (with Developer Mode on) -> Copy Role ID.
DISCORD_PREMIUM_ROLE_ID=

# Any long random string, e.g. `openssl rand -hex 32`. Signs the session
# tokens the app stores locally. Changing this logs everyone out.
SESSION_SECRET=

# The public URL this server is reachable at once deployed, no trailing
# slash. Must match the redirect URI you register in the Discord Developer
# Portal as `${PUBLIC_BASE_URL}/auth/callback`.
PUBLIC_BASE_URL=https://your-backend.example.com

PORT=3000
